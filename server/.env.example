APPHUB_ADDRESS=127.0.0.1:8787
APPHUB_PUBLIC_URL=https://hub.example.com
APPHUB_PROJECT_NAME=MyApphub

# 仅为格式示例。生产环境请分别执行 `openssl rand -hex 32` 生成两个不同的值。
APPHUB_TOKEN="replace-with-a-random-admin-token-at-least-32-bytes"
APPHUB_HMAC_SECRET="replace-with-a-different-random-secret-at-least-32-bytes"

# 相对路径统一以 server/（APPHUB_ROOT）为基准。
APPHUB_ROOT=.
APPHUB_DATA_DIR=data
APPHUB_RUNTIME_DIR=runtime
APPHUB_LOG_FILE=runtime/apphub.log
APPHUB_PROFILE_CERT=profile-cert.pem
APPHUB_PROFILE_KEY=profile-key.pem

# 允许独立部署的 Web Origin 跨域访问公开 API，多个地址使用英文逗号分隔。
APPHUB_CORS_ORIGINS=https://hub.example.com,http://localhost:5173,http://127.0.0.1:5173

APPHUB_TRUST_PROXY=true
APPHUB_MAX_PACKAGE_BYTES=1073741824
APPHUB_DISK_RESERVE_BYTES=10737418240
APPHUB_UPLOAD_TIMEOUT=30m
APPHUB_INSTALL_TOKEN_TTL=2h
APPHUB_UDID_TTL=30m
APPHUB_TRASH_RETENTION=168h
